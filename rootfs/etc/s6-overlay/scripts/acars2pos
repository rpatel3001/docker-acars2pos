#!/command/with-contenv bash
# shellcheck shell=bash
# shellcheck source-path=source-stubs
# shellcheck source-path=SCRIPTDIR

source /scripts/common

# exec so that python3 becomes the process s6-supervise watches directly.
# Without it the supervised process is this shell, so `s6-svc -r/-d` reaps the
# shell while python3 (and the node bridge it spawns) survive as orphans.
# shellcheck disable=SC2154
exec "${s6wrap[@]}" python3 -u /scripts/acars2pos.py
